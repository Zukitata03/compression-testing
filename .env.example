# postgres:16-alpine runs init scripts on first boot
DATABASE_URL=postgres://ct:ct@postgres:5432/compression
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ctminio
S3_SECRET_KEY=ctminio-secret
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_VARIANTS=variants
PORT=3000
# Cap ffmpeg encode threads. Default: half the machine's cores (min 2).
# Set explicitly on a shared server, e.g. 4 leaves the rest for other services.
FFMPEG_THREADS=4

# Docker CPU ceiling for the worker container (cpus=N means N cores' worth).
# 2 is a safe default next to other services; raise for a dedicated box.
WORKER_CPUS=2

# Network binds, same pattern as cloudreve-extend.
# Find yours: `ip -4 addr show` -> LAN (e.g. 192.168.x.x) and tailscale0 (100.x.x.x)
LAN_IP=192.168.1.123
TAILSCALE_IP=100.100.219.11
